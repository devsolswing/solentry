# Copy to .env and fill in real values. NEVER commit a real .env.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Required. Signs session cookies.
SESSION_SECRET=change-me-to-a-random-64-hex-string

# Required. 32-byte key for wallet encryption (64 hex chars).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me-to-a-random-64-hex-string

# devnet (default, safe) or mainnet. Mainnet only on explicit config.
NETWORK=devnet

# Optional. Defaults to the public RPC for NETWORK.
# RPC_URL=https://api.devnet.solana.com

# Optional. Where the SQLite file lives.
# DATABASE_PATH=tradingbot.db

# Optional. Paper starting cash per user.
# PAPER_START_CASH=10000

# Optional. Who may see /admin/donations (confirmed donations list).
# Default: the first registered user.
# ADMIN_USERNAME=

# Optional, OFF by default. Per-user Railway bot provisioning needs
# BOTH RAILWAY_PROVISIONING=1 AND RAILWAY_TOKEN set.
# RAILWAY_PROVISIONING=0
# RAILWAY_TOKEN=

# Optional, OFF by default. The silent-trading loop runs as a daemon
# thread inside the web process when SILENT_LOOP_ENABLED=1. It only
# ever trades for bots the user explicitly switched to silent.
# SILENT_LOOP_ENABLED=0
# SILENT_LOOP_INTERVAL_SECONDS=60

# Optional. Phone + email linking and two-code account recovery.
# Twilio sends the SMS codes; Resend sends the email codes. If either
# provider is missing, its codes cannot be sent and the app says so
# plainly instead of faking a send. Codes are 6 digits, expire in 10
# minutes, and stop working after 5 wrong tries.
# Twilio: account SID + auth token from the Twilio console, and the
# Twilio phone number that sends the texts (E.164, e.g. +12365550100).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Resend: API key from the Resend dashboard. RESEND_FROM_EMAIL must be
# a sender Resend allows for the key — use onboarding@resend.dev only
# for testing, or a verified domain sender in production.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=SolEntry <onboarding@resend.dev>
