# Copy to .env and fill in real values. NEVER commit a real .env.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Required. Signs session cookies.
SESSION_SECRET=change-me-to-a-random-64-hex-string

# Required. 32-byte key for wallet encryption (64 hex chars).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me-to-a-random-64-hex-string

# devnet (default, safe) or mainnet. Mainnet only on explicit config.
NETWORK=devnet

# Optional. Defaults to the public RPC for NETWORK.
# RPC_URL=https://api.devnet.solana.com

# Optional. Where the SQLite file lives.
# DATABASE_PATH=tradingbot.db

# Optional. Paper starting cash per user.
# PAPER_START_CASH=100

# Optional. Who may see /admin/donations (confirmed donations list).
# Default: the first registered user.
# ADMIN_USERNAME=

# Optional, OFF by default. Per-user Railway bot provisioning needs
# BOTH RAILWAY_PROVISIONING=1 AND RAILWAY_TOKEN set.
# RAILWAY_PROVISIONING=0
# RAILWAY_TOKEN=

# Optional, OFF by default. The silent-trading loop runs as a daemon
# thread inside the web process when SILENT_LOOP_ENABLED=1. It only
# ever trades for bots the user explicitly switched to silent.
# SILENT_LOOP_ENABLED=0
# SILENT_LOOP_INTERVAL_SECONDS=60

# Optional. Passkey sign-in (WebAuthn). These identify the app to the
# user's authenticator — the domain (RP ID) must match the site the
# user is on, or the browser rejects the ceremony. Dev defaults are
# for a local server; Railway MUST set the real values, e.g.
# WEBAUTHN_RP_ID=solentry-production.up.railway.app
# WEBAUTHN_RP_NAME=SolEntry
# WEBAUTHN_ORIGIN=https://solentry-production.up.railway.app

# Optional. Cloudflare Turnstile (free bot challenge on login/signup).
# BOTH must be set for the challenge to be enforced; with either
# missing the app logs a warning and continues without it. Free setup
# steps are in the README security page.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional. Live price feed (default 1 = on). The feed subscribes
# to Kraken's public WebSocket for majors and polls DexScreener for
# pump.fun mints; all sources are free and keyless. Set to 0 to stop
# the upstream threads — the app keeps serving from REST feeds.
# LIVE_FEED_ENABLED=1

# Optional. Per-wallet daily send cap in SOL (default 5). A send that
# would take today's total over this is refused.
# DAILY_SEND_LIMIT_SOL=5

# Required for real trades and donations. The ONE wallet that
# receives the 3.65% trading fee and all donations from the login
# screen — set in Railway, never in code or the repo. A valid base58
# 32-byte Solana address. If unset, empty, or invalid, real trades
# refuse loudly and the donate flow refuses plainly — never a
# fallback wallet, never a guessed address.
# FEE_RECIPIENT_PUBKEY=

# Required for the Security bot to email signup + recovery codes.
# Set in Railway, never in code or the repo. Without these, signup
# and Recover Account fail closed ("Email is not set up yet").
# For Gmail, SMTP_PASSWORD is an app password (not the account
# password). See the README "Email codes (Security bot)" section.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mintendont94@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=mintendont94@gmail.com
# SMTP_USE_TLS=1
# SECURITY_CODE_DEV_ECHO=0   # test-only fallback; NEVER 1 in production

# Optional. Secure session cookies (default 1 = on). Railway serves
# HTTPS, so leave it on. Set to 0 only for plain-HTTP local dev.
# SESSION_COOKIE_SECURE=1
